@model OnlinePatrika.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = Model.CurrentLang == "np" ? "समाचार प्रशासन ड्यासबोर्ड" : "Admin Dashboard";
    bool isNp = Model.CurrentLang == "np";
}

<div class="container" style="padding: 28px 0;">
    
    <!-- Error Alert Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background: rgba(239, 35, 60, 0.15); border-left: 4px solid #EF233C; color: #FF6B6B; padding: 14px 20px; border-radius: 8px; margin-bottom: 24px; font-weight: 600;">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Success Alert Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: rgba(16, 185, 129, 0.15); border-left: 4px solid #10B981; color: #10B981; padding: 14px 20px; border-radius: 8px; margin-bottom: 24px; font-weight: 600;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="font-size: 1.8rem; font-weight: 800;">
                <i class="fas fa-user-shield" style="color: var(--brand-blue);"></i> @(isNp ? "समाचार प्रशासन तथा अपलोड ड्यासबोर्ड" : "News Content Management & Admin Dashboard")
            </h1>
            <p style="color: var(--text-secondary); font-size: 0.9rem;">
                @(isNp ? "सामग्री अपलोड गर्नुहोस् (SQLite Persistence + ASP.NET Core 8.0 MVC)" : "Upload stories directly into SQLite Database via C# MVC")
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="#securitySettings" class="btn-primary" style="background: rgba(217, 4, 41, 0.2); border: 1px solid rgba(217, 4, 41, 0.4); color: white;">
                <i class="fas fa-key" style="color: #FFB703;"></i> <span>@(isNp ? "पासवर्ड र सुरक्षा सेटिङ" : "Change Password & User")</span>
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn-primary" style="background: var(--bg-card); border: 1px solid var(--border-color); color: white;">
                <i class="fas fa-globe"></i> <span>@(isNp ? "सार्वजनिक समाचार पोर्टल" : "Public Site")</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary" style="background: rgba(239, 35, 60, 0.2); border: 1px solid rgba(239, 35, 60, 0.4); color: #FF6B6B; cursor: pointer;">
                    <i class="fas fa-sign-out-alt"></i> <span>@(isNp ? "लगआउट (Logout)" : "Logout")</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Stats Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px;">
            <div style="width: 46px; height: 46px; background: linear-gradient(135deg, #D90429, #800020); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem;">
                <i class="fas fa-newspaper"></i>
            </div>
            <div>
                <div style="font-size: 1.6rem; font-weight: 800;">@Model.TotalArticles</div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">@(isNp ? "कुल समाचार" : "Total Articles")</div>
            </div>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px;">
            <div style="width: 46px; height: 46px; background: linear-gradient(135deg, #023E8A, #0077B6); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem;">
                <i class="fas fa-eye"></i>
            </div>
            <div>
                <div style="font-size: 1.6rem; font-weight: 800;">@Model.TotalViews</div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">@(isNp ? "जम्मा भ्यूज" : "Total Views")</div>
            </div>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px;">
            <div style="width: 46px; height: 46px; background: linear-gradient(135deg, #FFB703, #FB8500); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem;">
                <i class="fas fa-bolt"></i>
            </div>
            <div>
                <div style="font-size: 1.6rem; font-weight: 800;">@Model.BreakingCount</div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">@(isNp ? "ताजा खबर" : "Breaking News")</div>
            </div>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px;">
            <div style="width: 46px; height: 46px; background: linear-gradient(135deg, #2A9D8F, #10B981); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem;">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <div style="font-size: 1.6rem; font-weight: 800;">@Model.ActiveCategoriesCount</div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">@(isNp ? "सक्रिय विधाहरू" : "Active Menus")</div>
            </div>
        </div>
    </div>

    <!-- News Upload Form Card per Category Menu -->
    <div class="admin-card">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
            <i class="fas fa-pen-nib" style="color: var(--primary-red);"></i>
            @(isNp ? "नयाँ समाचार अपलोड फारम (Upload Content As Per Menus)" : "Upload Article Per Menu Category")
        </h2>

        <form asp-controller="Admin" asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" style="background: rgba(239, 35, 60, 0.15); border-left: 4px solid #EF233C; color: #EF233C; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-weight: 600;"></div>

            <!-- Category Menu Selector Dropdown -->
            <div style="margin-bottom: 20px;">
                <label style="font-weight: 700; display: block; margin-bottom: 6px; color: var(--brand-blue);">
                    <i class="fas fa-list-ul"></i> @(isNp ? "समाचार विधा छान्नुहोस् (Select Target Menu Category) *" : "Select Menu Category *")
                </label>
                <select asp-for="UploadModel.CategoryId" class="form-control" style="font-size: 1rem; font-weight: 600; padding: 12px;" required>
                    <option value="">-- विधा छान्नुहोस् / Choose Category --</option>
                    @foreach (var cat in Model.UploadModel.Categories)
                    {
                        <option value="@cat.Id">@(isNp ? cat.NameNp : cat.NameEn) (@cat.Slug)</option>
                    }
                </select>
            </div>

            <!-- Dual Language Titles -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">
                        <i class="fas fa-language"></i> @(isNp ? "नेपाली शीर्षक (Nepali Title) *" : "Nepali Title *")
                    </label>
                    <input asp-for="UploadModel.TitleNp" class="form-control" placeholder="उदा: सिक्किममा नयाँ प्रविधि विकास..." required />
                </div>
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">
                        <i class="fas fa-globe"></i> @(isNp ? "अंग्रेजी शीर्षक (English Title)" : "English Title")
                    </label>
                    <input asp-for="UploadModel.TitleEn" class="form-control" placeholder="Ex: New Technology Development in Sikkim..." />
                </div>
            </div>

            <!-- Dual Language Excerpts -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">नेपाली सारांश (Nepali Excerpt)</label>
                    <textarea asp-for="UploadModel.ExcerptNp" class="form-control" rows="2" placeholder="छोटो २ लाइन सारांश..."></textarea>
                </div>
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">अंग्रेजी सारांश (English Excerpt)</label>
                    <textarea asp-for="UploadModel.ExcerptEn" class="form-control" rows="2" placeholder="Short 2 line summary..."></textarea>
                </div>
            </div>

            <!-- Dual Language Content Body -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">नेपाली पूरा विवरण (Nepali Content) *</label>
                    <textarea asp-for="UploadModel.ContentNp" class="form-control" rows="6" placeholder="नेपाली भाषामा विस्तृत समाचार सामग्री यहाँ लेख्नुहोस्..." required></textarea>
                </div>
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">अंग्रेजी पूरा विवरण (English Content)</label>
                    <textarea asp-for="UploadModel.ContentEn" class="form-control" rows="6" placeholder="Write full article content in English here..."></textarea>
                </div>
            </div>

            <!-- Image Upload & Author -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">
                        <i class="fas fa-image"></i> @(isNp ? "फोटो URL वा कम्प्युटरबाट फाइल छान्नुहोस्" : "Featured Image URL or Upload File")
                    </label>
                    <input asp-for="UploadModel.ImageUrl" class="form-control" placeholder="@(isNp ? "https://images.unsplash.com/..." : "https://images.unsplash.com/...")" style="margin-bottom: 8px;" />
                    <input asp-for="UploadModel.ImageFile" type="file" class="form-control" accept="image/*" />
                </div>
                <div>
                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">@(isNp ? "संवाददाताको नाम (Author Name)" : "Author / Reporter Name")</label>
                    <input asp-for="UploadModel.Author" class="form-control" value="@(isNp ? "विशेष संवाददाता / Special Reporter" : "Special Correspondent")" />
                </div>
            </div>

            <!-- Toggles -->
            <div style="display: flex; gap: 24px; margin-bottom: 24px; flex-wrap: wrap;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input asp-for="UploadModel.IsBreaking" type="checkbox" style="width: 18px; height: 18px;" />
                    <span>@(isNp ? "ताजा खबर (Breaking News) मा देखाउनुहोस्" : "Show in Breaking News Ticker")</span>
                </label>

                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input asp-for="UploadModel.IsFeatured" type="checkbox" style="width: 18px; height: 18px;" />
                    <span>@(isNp ? "मुख्य आकर्षक कथा (Hero Featured Story) बनाउनुहोस्" : "Set as Hero Featured Story")</span>
                </label>
            </div>

            <button type="submit" class="btn-primary" style="font-size: 1.05rem; padding: 14px 32px;">
                <i class="fas fa-paper-plane"></i> @(isNp ? "समाचार प्रकाशित गर्नुहोस्" : "Publish Article to Database")
            </button>
        </form>
    </div>

    <!-- All Articles List Table -->
    <div class="admin-card">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
            <i class="fas fa-list-alt" style="color: var(--primary-red);"></i>
            @(isNp ? "सबै प्रकाशित समाचार सूची" : "All Published News Stories")
        </h2>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@(isNp ? "फोटो" : "Photo")</th>
                        <th>@(isNp ? "शीर्षक र लेखक" : "Title & Author")</th>
                        <th>@(isNp ? "विधा" : "Category")</th>
                        <th>@(isNp ? "प्रकार" : "Type")</th>
                        <th>@(isNp ? "भ्यूज" : "Views")</th>
                        <th>@(isNp ? "कार्यहरू" : "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var art in Model.Articles)
                    {
                        <tr>
                            <td><strong>#@art.Id</strong></td>
                            <td><img src="@art.ImageUrl" style="width: 48px; height: 36px; object-fit: cover; border-radius: 4px;" alt="Img" /></td>
                            <td>
                                <div style="font-weight: 700; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(isNp ? art.TitleNp : (string.IsNullOrEmpty(art.TitleEn) ? art.TitleNp : art.TitleEn))
                                </div>
                                <small style="color: var(--text-muted);">@art.Author</small>
                            </td>
                            <td>
                                <span style="background: rgba(14, 165, 233, 0.15); color: #0EA5E9; padding: 3px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 700;">
                                    @(isNp ? art.Category?.NameNp : art.Category?.NameEn)
                                </span>
                            </td>
                            <td>
                                @if (art.IsBreaking)
                                {
                                    <span style="background: rgba(239, 35, 60, 0.15); color: #EF233C; padding: 3px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 700;">@(isNp ? "ताजा खबर" : "Breaking")</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted); font-size: 0.85rem;">@(isNp ? "सामान्य" : "Standard")</span>
                                }
                            </td>
                            <td><i class="far fa-eye"></i> @art.ViewsCount</td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <form asp-controller="Admin" asp-action="ToggleBreaking" asp-route-id="@art.Id" method="post" style="display:inline;">
                                        <button type="submit" title="@(isNp ? "ताजा खबर टगल गर्नुहोस्" : "Toggle Breaking News")" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: white; width: 32px; height: 32px; border-radius: 4px; cursor: pointer;">
                                            <i class="fas fa-bolt" style="color: @(art.IsBreaking ? "var(--primary-red)" : "var(--text-muted)");"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="Delete" asp-route-id="@art.Id" method="post" style="display:inline;" onsubmit="return confirm('@(isNp ? "के तपाईं यो समाचार हटाउन निश्चित हुनुहुन्छ?" : "Are you sure you want to delete this article?")');">
                                        <button type="submit" title="@(isNp ? "हटाउनुहोस्" : "Delete Article")" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: #EF233C; width: 32px; height: 32px; border-radius: 4px; cursor: pointer;">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Security & Account Settings (Change Username and Password) -->
    <div class="admin-card" id="securitySettings" style="margin-top: 32px; border: 1px solid rgba(217, 4, 41, 0.3); background: rgba(15, 23, 42, 0.6); position: relative; overflow: hidden;">
        <div style="position: absolute; top: -40px; right: -40px; width: 120px; height: 120px; background: rgba(217, 4, 41, 0.15); filter: blur(40px); border-radius: 50%; pointer-events: none;"></div>

        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 14px; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #D90429, #800020); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.2rem; box-shadow: 0 4px 12px rgba(217, 4, 41, 0.3);">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div>
                    <h2 style="font-size: 1.3rem; font-weight: 700; margin: 0; color: #FFF;">
                        @(isNp ? "प्रशासक खाता तथा सुरक्षा सेटिङ" : "Admin Account & Security Settings")
                    </h2>
                    <small style="color: var(--text-secondary);">
                        @(isNp ? "ड्यासबोर्ड लगइन प्रयोगकर्ता नाम र पासवर्ड यहाँबाट परिवर्तन गर्नुहोस्" : "Update login username and password for admin dashboard access")
                    </small>
                </div>
            </div>
            <div>
                <span style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); padding: 6px 14px; border-radius: 9999px; font-size: 0.85rem; color: #CBD5E1;">
                    <i class="fas fa-user-circle" style="color: var(--primary-red); margin-right: 6px;"></i>
                    @(isNp ? "हालको प्रयोगकर्ता:" : "Current User:") <strong style="color: #FFF;">@Model.CurrentAdminUsername</strong>
                </span>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="ChangeCredentials" method="post">
            @Html.AntiForgeryToken()

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px;">
                
                <!-- Left Column: Username & Current Password -->
                <div style="background: rgba(30, 41, 59, 0.5); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color);">
                    <h3 style="font-size: 1rem; font-weight: 700; color: #E2E8F0; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-id-badge" style="color: var(--brand-blue);"></i> @(isNp ? "प्रयोगकर्ता नाम परिमार्जन" : "Change Username")
                    </h3>

                    <div style="margin-bottom: 18px;">
                        <label style="font-size: 0.88rem; font-weight: 600; color: #CBD5E1; display: block; margin-bottom: 8px;">
                            @(isNp ? "नयाँ प्रयोगकर्ता नाम *" : "New Username *")
                        </label>
                        <input asp-for="ChangeCredentialsModel.NewUsername" class="form-control" placeholder="@(isNp ? "उदा: admin_news" : "Ex: admin_news")" required style="width: 100%;" />
                        <span asp-validation-for="ChangeCredentialsModel.NewUsername" style="color: #FF6B6B; font-size: 0.8rem; margin-top: 4px; display: block;"></span>
                    </div>

                    <div style="margin-bottom: 8px;">
                        <label style="font-size: 0.88rem; font-weight: 600; color: #CBD5E1; display: block; margin-bottom: 8px;">
                            @(isNp ? "हालको पासवर्ड *" : "Current Password *")
                        </label>
                        <div style="position: relative;">
                            <input asp-for="ChangeCredentialsModel.CurrentPassword" type="password" id="curPassInput" class="form-control" placeholder="••••••••" required style="width: 100%; padding-right: 40px;" />
                            <button type="button" onclick="togglePass('curPassInput', 'curPassIcon')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94A3B8; cursor: pointer;">
                                <i class="fas fa-eye" id="curPassIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ChangeCredentialsModel.CurrentPassword" style="color: #FF6B6B; font-size: 0.8rem; margin-top: 4px; display: block;"></span>
                    </div>
                </div>

                <!-- Right Column: New Password & Confirmation -->
                <div style="background: rgba(30, 41, 59, 0.5); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color);">
                    <h3 style="font-size: 1rem; font-weight: 700; color: #E2E8F0; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-lock" style="color: var(--primary-red);"></i> @(isNp ? "नयाँ पासवर्ड सेटिङ" : "Change Password")
                    </h3>

                    <div style="margin-bottom: 18px;">
                        <label style="font-size: 0.88rem; font-weight: 600; color: #CBD5E1; display: block; margin-bottom: 8px;">
                            @(isNp ? "नयाँ पासवर्ड *" : "New Password *")
                        </label>
                        <div style="position: relative;">
                            <input asp-for="ChangeCredentialsModel.NewPassword" type="password" id="newPassInput" class="form-control" placeholder="@(isNp ? "कम्तीमा ४ अक्षरको नयाँ पासवर्ड" : "At least 4 characters")" required style="width: 100%; padding-right: 40px;" />
                            <button type="button" onclick="togglePass('newPassInput', 'newPassIcon')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94A3B8; cursor: pointer;">
                                <i class="fas fa-eye" id="newPassIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ChangeCredentialsModel.NewPassword" style="color: #FF6B6B; font-size: 0.8rem; margin-top: 4px; display: block;"></span>
                    </div>

                    <div style="margin-bottom: 8px;">
                        <label style="font-size: 0.88rem; font-weight: 600; color: #CBD5E1; display: block; margin-bottom: 8px;">
                            @(isNp ? "नयाँ पासवर्ड पुष्टि गर्नुहोस् *" : "Confirm New Password *")
                        </label>
                        <div style="position: relative;">
                            <input asp-for="ChangeCredentialsModel.ConfirmPassword" type="password" id="confirmPassInput" class="form-control" placeholder="@(isNp ? "नयाँ पासवर्ड पुनः प्रविष्ट गर्नुहोस्" : "Re-enter new password")" required style="width: 100%; padding-right: 40px;" />
                            <button type="button" onclick="togglePass('confirmPassInput', 'confirmPassIcon')" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94A3B8; cursor: pointer;">
                                <i class="fas fa-eye" id="confirmPassIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ChangeCredentialsModel.ConfirmPassword" style="color: #FF6B6B; font-size: 0.8rem; margin-top: 4px; display: block;"></span>
                    </div>
                </div>

            </div>

            <div style="display: flex; justify-content: flex-end;">
                <button type="submit" class="btn-primary" style="padding: 12px 28px; font-size: 0.98rem; font-weight: 700; background: linear-gradient(135deg, #D90429, #EF233C); border: none; border-radius: 8px; color: white; cursor: pointer; box-shadow: 0 4px 14px rgba(217, 4, 41, 0.35); display: inline-flex; align-items: center; gap: 8px;">
                    <i class="fas fa-save"></i> @(isNp ? "प्रयोगकर्ता नाम र पासवर्ड अद्यावधिक गर्नुहोस्" : "Update Username & Password")
                </button>
            </div>
        </form>
    </div>

</div>

<script>
    function togglePass(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>
