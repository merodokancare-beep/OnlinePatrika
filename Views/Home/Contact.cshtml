@{
    string lang = ViewBag.CurrentLang ?? "np";
    bool isNp = lang == "np";
    ViewData["Title"] = isNp ? "सम्पर्क गर्नुहोस्" : "Contact Us";
}

<div class="container" style="padding: 40px 0;">
    <div style="max-width: 960px; margin: 0 auto;">
        
        <h1 style="font-size: 2.2rem; font-weight: 800; border-bottom: 3px solid var(--primary-red); padding-bottom: 12px; margin-bottom: 24px; color: var(--text-primary);">
            <i class="fas fa-headset" style="color: var(--primary-red);"></i> @(isNp ? "हामीलाई सम्पर्क गर्नुहोस् (Contact Us)" : "Contact Newsroom & Bureau")
        </h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background: rgba(16, 185, 129, 0.15); border-left: 4px solid #10B981; color: #10B981; padding: 14px 20px; border-radius: 8px; margin-bottom: 24px; font-weight: 600;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
            
            <!-- Contact Info Box -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 28px;">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px; color: var(--brand-blue);">
                    <i class="fas fa-building"></i> @(isNp ? "केन्द्रीय कार्यालय र डेस्क" : "Central Bureau Contact")
                </h3>

                <!-- Managing Director Contact Badge -->
                <div style="display: flex; align-items: center; gap: 16px; background: var(--bg-main); border: 1px solid var(--border-color); padding: 14px; border-radius: 12px; margin-bottom: 20px;">
                    <img src="~/images/managing-director.jpg" style="width: 54px; height: 62px; object-fit: cover; border-radius: 8px; border: 2px solid var(--primary-red);" alt="Bishnu Neopaney" />
                    <div>
                        <div style="font-weight: 800; font-size: 1.05rem; color: var(--text-primary);">@(isNp ? "विष्णु न्यौपाने (Bishnu Neopaney)" : "Bishnu Neopaney")</div>
                        <div style="color: var(--primary-red); font-size: 0.85rem; font-weight: 700;">@(isNp ? "प्रबन्ध निर्देशक (Managing Director)" : "Managing Director")</div>
                        <div style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 2px;"><i class="fas fa-envelope" style="color: var(--primary-red); margin-right: 4px;"></i> v.neopaney@gmail.com</div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 16px; font-size: 1.02rem;">
                    <div>
                        <strong style="display: block; color: var(--text-primary);"><i class="fas fa-map-marker-alt" style="color: var(--primary-red); margin-right: 8px;"></i> @(isNp ? "ठेगाना:" : "Address:")</strong>
                        <span style="color: var(--text-secondary);">@(isNp ? "डेभलपमेन्ट एरिया, नेपाली साहित्य परिषद् नजिक, जीवन थिङ मार्ग, ग्याङटोक - सिक्किम। पिन-७३७१०१" : "Development Area, Near Nepali Sahitya Parishad, Jeewan Theeng Marg, Gangtok - Sikkim. Pin-737101")</span>
                    </div>

                    <div>
                        <strong style="display: block; color: var(--text-primary);"><i class="fas fa-phone-alt" style="color: var(--primary-red); margin-right: 8px;"></i> @(isNp ? "फोन / हटलाइन:" : "Phone / Hotline:")</strong>
                        <span style="color: var(--text-secondary);">@(isNp ? "+९१-९८८३७०२८०७" : "+91-9883702807")</span>
                    </div>

                    <div>
                        <strong style="display: block; color: var(--text-primary);"><i class="fas fa-envelope" style="color: var(--primary-red); margin-right: 8px;"></i> @(isNp ? "इमेल समाचार डेस्क:" : "Newsroom Email:")</strong>
                        <span style="color: var(--text-secondary);">v.neopaney@gmail.com</span>
                    </div>

                    <div>
                        <strong style="display: block; color: var(--text-primary);"><i class="fas fa-ad" style="color: var(--primary-red); margin-right: 8px;"></i> @(isNp ? "विज्ञापन शाखा:" : "Advertising Bureau:")</strong>
                        <span style="color: var(--text-secondary);">v.neopaney@gmail.com</span>
                    </div>
                </div>
            </div>

            <!-- Interactive Inquiry Form -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 28px;">
                <h3 style="font-size: 1.3rem; margin-bottom: 20px; color: var(--brand-blue);">
                    <i class="fas fa-paper-plane"></i> @(isNp ? "समाचार वा सुझाव पठाउनुहोस्" : "Send News Tip or Inquiry")
                </h3>

                <form asp-controller="Home" asp-action="Contact" method="post">
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">@(isNp ? "तपाईंको नाम *" : "Your Name *")</label>
                        <input type="text" name="senderName" class="form-control" placeholder="उदा: रमेश शर्मा" required />
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">@(isNp ? "इमेल ठेगाना *" : "Email Address *")</label>
                        <input type="email" name="senderEmail" class="form-control" placeholder="example@email.com" required />
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">@(isNp ? "विषय *" : "Subject *")</label>
                        <input type="text" name="subject" class="form-control" placeholder="समाचार सुझव / विज्ञापन / जिज्ञासा" required />
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 6px;">@(isNp ? "सन्देश / विवरण *" : "Message / News Tip *")</label>
                        <textarea name="message" class="form-control" rows="4" placeholder="विस्तृत विवरण यहाँ लेख्नुहोस्..." required></textarea>
                    </div>

                    <button type="submit" class="btn-primary" style="width: 100%; padding: 12px; font-size: 1rem;">
                        <i class="fas fa-paper-plane"></i> @(isNp ? "सन्देश पठाउनुहोस्" : "Submit Message")
                    </button>
                </form>
            </div>

        </div>

    </div>
</div>
