@using System.Text.Encodings.Web
@model OnlinePatrika.Models.Article
@{
    string lang = ViewBag.CurrentLang ?? "np";
    bool isNp = lang == "np";
    string displayTitle = isNp ? Model.TitleNp : (!string.IsNullOrEmpty(Model.TitleEn) ? Model.TitleEn : Model.TitleNp);
    string displayExcerpt = isNp ? (Model.ExcerptNp ?? "") : (!string.IsNullOrEmpty(Model.ExcerptEn) ? Model.ExcerptEn : (Model.ExcerptNp ?? ""));
    string displayContent = isNp ? Model.ContentNp : (!string.IsNullOrEmpty(Model.ContentEn) ? Model.ContentEn : Model.ContentNp);
    ViewData["Title"] = displayTitle;
    var related = ViewBag.RelatedArticles as List<OnlinePatrika.Models.Article> ?? new List<OnlinePatrika.Models.Article>();

    string currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    string encodedUrl = System.Net.WebUtility.UrlEncode(currentUrl);
    string encodedTitle = System.Net.WebUtility.UrlEncode(displayTitle);
}

@section Scripts {
    <!-- Google News / SEO Schema.org JSON-LD Structured Data for NewsArticle -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "NewsArticle",
      "mainEntityOfPage": {
        "@@type": "WebPage",
        "@@id": "@currentUrl"
      },
      "headline": "@JavaScriptEncoder.Default.Encode(displayTitle)",
      "description": "@JavaScriptEncoder.Default.Encode(displayExcerpt)",
      "image": [
        "@Model.ImageUrl"
      ],
      "datePublished": "@Model.CreatedAtAd.ToString("yyyy-MM-ddTHH:mm:ssK")",
      "dateModified": "@Model.CreatedAtAd.ToString("yyyy-MM-ddTHH:mm:ssK")",
      "author": {
        "@@type": "Person",
        "name": "@Model.Author"
      },
      "publisher": {
        "@@type": "Organization",
        "name": "अनलाइन् खबर पत्रिका",
        "logo": {
          "@@type": "ImageObject",
          "url": "@Context.Request.Scheme://@Context.Request.Host/images/brand-logoEdited.jpeg"
        }
      }
    }
    </script>

    <script>
        function copyArticleLink() {
            navigator.clipboard.writeText(window.location.href).then(function() {
                const toast = document.getElementById('copyToast');
                if (toast) {
                    toast.style.display = 'block';
                    setTimeout(() => { toast.style.display = 'none'; }, 3000);
                }
            });
        }
    </script>
}

<div class="container" style="padding: 32px 0;">
    <div style="max-width: 880px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 32px;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <a asp-controller="Home" asp-action="Index" style="display: inline-flex; align-items: center; gap: 6px; color: var(--primary-red); font-weight: 600;">
                <i class="fas fa-arrow-left"></i> @(isNp ? "मुख्य पृष्ठमा फर्कनुहोस्" : "Back to Home")
            </a>
            <a asp-controller="Home" asp-action="EditorialPolicy" style="font-size: 0.82rem; color: var(--text-muted); text-decoration: underline;">
                <i class="fas fa-user-check"></i> @(isNp ? "सम्पादकीय नीति र तथ्य जाँच" : "Editorial Policy & Fact Check")
            </a>
        </div>

        <span class="category-tag">@(isNp ? Model.Category?.NameNp : Model.Category?.NameEn)</span>

        <h1 style="font-size: 2.2rem; font-weight: 800; line-height: 1.3; margin: 12px 0 16px; color: var(--text-primary);">
            @displayTitle
        </h1>

        <!-- Date, Time & Author Bar -->
        <div style="display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); padding: 14px 0; margin-bottom: 20px; font-size: 0.88rem; color: var(--text-secondary);">
            <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
                <div><i class="far fa-user" style="color: var(--primary-red);"></i> <strong>@Model.Author</strong></div>
                <div><i class="far fa-calendar-alt" style="color: var(--brand-blue);"></i> @(isNp ? Model.DateBs : Model.CreatedAtAd.ToString("MMM dd, yyyy"))</div>
                <div><i class="far fa-clock" style="color: #FFB703;"></i> @(isNp ? "१०:१५ बजे | अद्यावधिक: १०:४५" : Model.CreatedAtAd.ToString("hh:mm tt"))</div>
            </div>
            <div><i class="far fa-eye"></i> @Model.ViewsCount @(isNp ? "पटक हेरिएको" : "Views")</div>
        </div>

        <!-- 1-Click Social Sharing Buttons Bar -->
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; background: var(--bg-main); padding: 12px 16px; border-radius: 10px; border: 1px solid var(--border-color);">
            <span style="font-weight: 700; font-size: 0.9rem; color: var(--text-primary);"><i class="fas fa-share-alt" style="color: var(--primary-red);"></i> @(isNp ? "सेयर गर्नुहोस्:" : "Share Article:")</span>
            
            <!-- Facebook -->
            <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" style="background: #1877F2; color: white; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fab fa-facebook-f"></i> Facebook
            </a>

            <!-- X / Twitter -->
            <a href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedTitle" target="_blank" style="background: #000; color: white; border: 1px solid #333; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fab fa-x-twitter"></i> Twitter
            </a>

            <!-- WhatsApp -->
            <a href="https://api.whatsapp.com/send?text=@encodedTitle%20@encodedUrl" target="_blank" style="background: #25D366; color: white; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fab fa-whatsapp"></i> WhatsApp
            </a>

            <!-- Viber -->
            <a href="viber://forward?text=@encodedTitle%20@encodedUrl" target="_blank" style="background: #7360F2; color: white; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fab fa-viber"></i> Viber
            </a>

            <!-- Copy Link Button -->
            <button type="button" onclick="copyArticleLink()" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-link"></i> @(isNp ? "लिङ्क कपी" : "Copy Link")
            </button>

            <!-- Copy Toast Notification -->
            <div id="copyToast" style="display: none; background: #10B981; color: white; padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 700;">
                <i class="fas fa-check"></i> @(isNp ? "लिङ्क कपी भयो!" : "Link copied!")
            </div>
        </div>

        <!-- Main Feature Image -->
        <img src="@Model.ImageUrl" style="width: 100%; max-height: 460px; object-fit: cover; border-radius: 12px; margin-bottom: 24px;" alt="@displayTitle" />

        <!-- Full Article Content Body -->
        <div style="font-size: 1.15rem; line-height: 1.85; color: var(--text-primary);">
            @Html.Raw(displayContent.Replace("\n", "<br/><br/>"))
        </div>

        <!-- YouTube Video & Facebook Integration Section (If Video category or featured report) -->
        @if (Model.Category?.Slug == "video" || Model.Category?.Slug == "photo-gallery")
        {
            <div style="margin: 36px 0; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px;">
                <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 14px; color: var(--brand-blue);">
                    <i class="fab fa-youtube" style="color: #FF0000;"></i> @(isNp ? "विशेष भिडियो रिपोर्ट (YouTube Video Integration)" : "Special Video Report")
                </h3>
                <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 10px; background: black;">
                    <iframe style="position: absolute; top:0; left: 0; width: 100%; height: 100%; border: 0;" src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>
        }

        <!-- Fact Check & Transparency Badge -->
        <div style="margin-top: 32px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 10px; padding: 16px; display: flex; align-items: center; gap: 12px; font-size: 0.88rem; color: #10B981;">
            <i class="fas fa-shield-alt fa-2x"></i>
            <div>
                <strong>@(isNp ? "अनलाइन् खबर पत्रिका तथ्य जाँच र आचारसंहिता प्रतिवेदन:" : "Fact-Checked & Verified Report:")</strong>
                <div>@(isNp ? "यो सामग्री हाम्रा सम्पादक टोलीद्वारा तथ्य प्रमाणीकरण र प्रेस काउन्सिल आचारसंहिता बमोजिम प्रकाशित गरिएको हो।" : "This article adheres strictly to Press Council Nepal ethical standards and editorial verification.")</div>
            </div>
        </div>

        <!-- Related News Section -->
        @if (related.Any())
        {
            <div style="margin-top: 44px; border-top: 2px solid var(--border-color); padding-top: 24px;">
                <h3 style="font-size: 1.3rem; margin-bottom: 16px;"><i class="fas fa-newspaper" style="color: var(--primary-red);"></i> @(isNp ? "सम्बन्धित समाचारहरू" : "Related Articles")</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
                    @foreach (var item in related)
                    {
                        string itemTitle = isNp ? item.TitleNp : (!string.IsNullOrEmpty(item.TitleEn) ? item.TitleEn : item.TitleNp);
                        <div style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
                            <img src="@item.ImageUrl" style="width: 100%; height: 130px; object-fit: cover; border-radius: 6px; margin-bottom: 8px;" alt="News" />
                            <h4 style="font-size: 0.95rem; font-weight: 700; line-height: 1.4;">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.Id">@itemTitle</a>
                            </h4>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>
