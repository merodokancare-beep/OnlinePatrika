@model OnlinePatrika.ViewModels.HomeViewModel
@{
    ViewData["Title"] = Model.CurrentLang == "np" ? "मुख्य पृष्ठ" : "Home";
    bool isNp = Model.CurrentLang == "np";
}

@functions {
    string GetCategoryIcon(string slug)
    {
        return slug switch
        {
            "national" => "fa-flag",
            "state" => "fa-map-marked-alt",
            "economy" => "fa-chart-line",
            "sports" => "fa-futbol",
            "opinion" => "fa-pen-nib",
            "video" => "fa-video",
            "photo-gallery" => "fa-images",
            _ => "fa-newspaper"
        };
    }
}

<!-- Navigation Categories Bar -->
<nav class="nav-bar">
    <div class="container">
        <ul class="nav-links">
            <li class="nav-link-item @(Model.SelectedCategorySlug == "all" ? "active" : "")">
                <a asp-controller="Home" asp-action="Index" asp-route-category="all">
                    <i class="fas fa-home" style="margin-right: 8px; opacity: 0.9; width: 18px; text-align: center;"></i>
                    <span>@(isNp ? "गृहपृष्ठ" : "Home")</span>
                </a>
            </li>
            @foreach (var cat in Model.Categories)
            {
                <li class="nav-link-item @(Model.SelectedCategorySlug == cat.Slug ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index" asp-route-category="@cat.Slug">
                        <i class="fas @GetCategoryIcon(cat.Slug)" style="margin-right: 8px; opacity: 0.9; width: 18px; text-align: center;"></i>
                        <span>@(isNp ? cat.NameNp : cat.NameEn)</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>

<!-- Breaking News Ticker -->
@if (Model.BreakingNews.Any())
{
    <div class="breaking-ticker">
        <div class="ticker-label">
            <i class="fas fa-bolt"></i> <span>@(isNp ? "ताजा खबर" : "BREAKING")</span>
        </div>
        <div style="padding: 0 16px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            @foreach (var b in Model.BreakingNews)
            {
                string bTitle = isNp ? b.TitleNp : (!string.IsNullOrEmpty(b.TitleEn) ? b.TitleEn : b.TitleNp);
                <a asp-controller="Home" asp-action="Detail" asp-route-id="@b.Id" style="margin-right: 24px; color: var(--text-primary);">
                    <i class="fas fa-angle-right" style="color: var(--primary-red);"></i> @bTitle
                </a>
            }
        </div>
    </div>
}

<main class="container hero-news-section">
    <!-- Hero Grid -->
    <div class="hero-grid">
        @if (Model.HeroArticle != null)
        {
            string heroTitle = isNp ? Model.HeroArticle.TitleNp : (!string.IsNullOrEmpty(Model.HeroArticle.TitleEn) ? Model.HeroArticle.TitleEn : Model.HeroArticle.TitleNp);
            string heroExcerpt = isNp ? (Model.HeroArticle.ExcerptNp ?? "") : (!string.IsNullOrEmpty(Model.HeroArticle.ExcerptEn) ? Model.HeroArticle.ExcerptEn : (Model.HeroArticle.ExcerptNp ?? ""));

            <div class="lead-story-card">
                <img src="@Model.HeroArticle.ImageUrl" alt="Hero Image" class="story-img-overlay" />
                <div class="story-gradient"></div>
                <div class="story-content">
                    <span class="category-tag">@(isNp ? Model.HeroArticle.Category?.NameNp : Model.HeroArticle.Category?.NameEn)</span>
                    <h1 class="story-title">
                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@Model.HeroArticle.Id" style="color:white;">
                            @heroTitle
                        </a>
                    </h1>
                    <p style="color: #CBD5E1; margin-bottom: 12px;">@heroExcerpt</p>
                    <div style="display: flex; gap: 16px; font-size: 0.85rem; color: #94A3B8;">
                        <span><i class="far fa-user"></i> @Model.HeroArticle.Author</span>
                        <span><i class="far fa-clock"></i> @(isNp ? Model.HeroArticle.DateBs : Model.HeroArticle.CreatedAtAd.ToString("MMM dd, yyyy"))</span>
                        <span><i class="far fa-eye"></i> @Model.HeroArticle.ViewsCount</span>
                    </div>
                </div>
            </div>
        }

        <!-- Side Trending Stories -->
        <div style="display: flex; flex-direction: column; gap: 14px;">
            <h3 style="border-bottom: 2px solid var(--primary-red); padding-bottom: 8px; font-size: 1.2rem;">
                <i class="fas fa-fire" style="color: var(--primary-red);"></i> @(isNp ? "मुख्य प्राथमिकता" : "Trending Headlines")
            </h3>
            @foreach (var item in Model.TrendingArticles)
            {
                string trendTitle = isNp ? item.TitleNp : (!string.IsNullOrEmpty(item.TitleEn) ? item.TitleEn : item.TitleNp);
                <div style="display: flex; gap: 12px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px;">
                    <img src="@item.ImageUrl" style="width: 90px; height: 70px; object-fit: cover; border-radius: 6px;" alt="News" />
                    <div>
                        <h4 style="font-size: 0.95rem; font-weight: 700; line-height: 1.3; margin-bottom: 4px;">
                            <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.Id">@trendTitle</a>
                        </h4>
                        <small style="color: var(--text-muted);"><i class="far fa-eye"></i> @item.ViewsCount</small>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main News Grid per Menu Category -->
    <div style="margin: 36px 0 20px; border-bottom: 2px solid var(--border-color); padding-bottom: 8px;">
        <h2 style="font-size: 1.5rem; font-weight: 800;">
            <i class="fas fa-layer-group" style="color: var(--primary-red);"></i>
            @(isNp ? "ताजा समाचार सङ्गालो" : "Latest News Articles")
        </h2>
    </div>

    <div class="news-grid">
        @foreach (var article in Model.Articles)
        {
            string artTitle = isNp ? article.TitleNp : (!string.IsNullOrEmpty(article.TitleEn) ? article.TitleEn : article.TitleNp);
            string artExcerpt = isNp ? (article.ExcerptNp ?? "") : (!string.IsNullOrEmpty(article.ExcerptEn) ? article.ExcerptEn : (article.ExcerptNp ?? ""));

            <article class="news-card">
                <img src="@article.ImageUrl" alt="News Image" class="news-card-img" />
                <div class="news-card-body">
                    <span class="category-tag" style="align-self: flex-start;">@(isNp ? article.Category?.NameNp : article.Category?.NameEn)</span>
                    <h3 class="news-card-title">
                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@article.Id">@artTitle</a>
                    </h3>
                    <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 12px;">@artExcerpt</p>
                    <div style="margin-top: auto; display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 10px;">
                        <span><i class="far fa-user"></i> @article.Author?.Split('/')[0]</span>
                        <span><i class="far fa-eye"></i> @article.ViewsCount</span>
                    </div>
                </div>
            </article>
        }
    </div>
</main>
