@{
    string currentLang = Context.Request.Cookies["PatrikaLang"] ?? "np";
    bool isNepali = currentLang == "np";
}
<!DOCTYPE html>
<html lang="@currentLang" data-theme="dark" data-font-size="medium">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - अनलाइन् खबर पत्रिका (Online Khabar Patrika)</title>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Mukta:wght@300;400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/styles.css" />

    <!-- Early Theme & Font Size Script to prevent layout flash -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('patrikaTheme') || 'dark';
            const savedFontSize = localStorage.getItem('patrikaFontSize') || 'medium';
            document.documentElement.setAttribute('data-theme', savedTheme);
            document.documentElement.setAttribute('data-font-size', savedFontSize);
        })();
    </script>
</head>
<body lang="@currentLang">

    <!-- Top Utility Bar -->
    <div class="top-bar">
        <div class="container top-bar-content">
            <div class="top-bar-left">
                <div class="date-badge">
                    <i class="far fa-calendar-alt" style="color: var(--primary-red);"></i>
                    <span>@(isNepali ? "वि.सं. २०८३ श्रावण २४, शनिबार" : "August 8, 2026, Saturday")</span>
                </div>
                <div><i class="fas fa-sun" style="color:#FFB703;"></i> सिक्किम २५°C</div>
                <div><i class="fas fa-dollar-sign"></i> USD/INR: ८३.५०</div>
            </div>
            <div class="top-bar-right">
                <!-- Font Size Switcher Widget (Small, Medium, Large) -->
                <div class="font-size-switcher" title="@(isNepali ? "अक्षरको आकार छान्नुहोस्" : "Select Font Size")">
                    <button type="button" class="font-size-btn" data-size="small" title="@(isNepali ? "सानो अक्षर" : "Small Font")">A-</button>
                    <button type="button" class="font-size-btn active" data-size="medium" title="@(isNepali ? "मध्यम अक्षर" : "Medium Font")">A</button>
                    <button type="button" class="font-size-btn" data-size="large" title="@(isNepali ? "ठूलो अक्षर" : "Large Font")">A+</button>
                </div>

                <!-- Theme Switcher (Dark / Bright Mode) -->
                <button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle Theme" title="@(isNepali ? "डार्क/लाइट थिम परिर्वतन गर्नुहोस्" : "Toggle Dark/Light Mode")">
                    <i class="fas fa-sun"></i>
                </button>

                <!-- Language Switcher -->
                <div class="lang-switcher">
                    <form asp-controller="Home" asp-action="SetLanguage" method="post" style="display:inline-flex;">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" name="lang" value="np" class="lang-btn @(isNepali ? "active" : "")">नेपाली</button>
                        <button type="submit" name="lang" value="en" class="lang-btn @(!isNepali ? "active" : "")">English</button>
                    </form>
                </div>

                <!-- Quick Auth Login / Logout Link -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline-flex;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="lang-btn" style="background: rgba(239, 35, 60, 0.2); color: #FF6B6B; border: 1px solid rgba(239, 35, 60, 0.4); cursor: pointer;" title="@(isNepali ? "लगआउट" : "Logout")">
                            <i class="fas fa-sign-out-alt"></i> @(isNepali ? "लगआउट" : "Logout")
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="lang-btn" style="background: rgba(217, 4, 41, 0.25); color: #FFF; border: 1px solid rgba(217, 4, 41, 0.5); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="@(isNepali ? "लगइन गर्नुहोस्" : "Login")">
                        <i class="fas fa-sign-in-alt"></i> @(isNepali ? "लगइन" : "Login")
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Header & Logo -->
    <header class="main-header">
        <div class="container header-inner">
            <a asp-controller="Home" asp-action="Index" class="brand-logo">
                <img src="~/images/brand-logoEdited.jpeg" alt="अनलाइन् खबर पत्रिका" class="brand-logo-img" />
            </a>

            <div style="display: flex; align-items: center; gap: 12px;">
                <form asp-controller="Home" asp-action="Index" method="get" style="position: relative;" class="desktop-search">
                    <i class="fas fa-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748B;"></i>
                    <input type="text" name="q" class="form-control" style="padding-left: 36px; border-radius: 9999px; width: 240px;" placeholder="@(isNepali ? "समाचार खोज्नुहोस्..." : "Search news...")" />
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem; border-radius: 9999px; background: linear-gradient(135deg, #10B981, #059669);">
                        <i class="fas fa-user-shield"></i> <span>@(isNepali ? "प्रशासन ड्यासबोर्ड" : "Dashboard")</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem; border-radius: 9999px; background: linear-gradient(135deg, #D90429, #EF233C); color: white; box-shadow: 0 4px 12px rgba(217, 4, 41, 0.35);">
                        <i class="fas fa-user-lock"></i> <span>@(isNepali ? "लगइन" : "Login")</span>
                    </a>
                }

                <!-- Mobile Navigation Toggle Button -->
                <button class="mobile-nav-toggle" id="mobileNavBtn" aria-label="Toggle Menu">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    @RenderBody()

    <!-- Enhanced Newsroom Footer -->
    <footer style="background: var(--bg-topbar); border-top: 1px solid var(--border-color); padding: 48px 0 24px; margin-top: 60px; color: var(--text-secondary);">
        <div class="container">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; margin-bottom: 32px;">
                
                <!-- Brand Info -->
                <div>
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                        <img src="~/images/brand-logoEdited.jpeg" style="height: 48px; border-radius: 6px;" alt="Logo" />
                        <div>
                            <h3 style="color: var(--text-primary); margin: 0; font-size: 1.2rem;">@(isNepali ? "अनलाइन् खबर पत्रिका" : "Online Khabar Patrika")</h3>
                            <small style="color: var(--text-muted);">@(isNepali ? "निष्पक्ष र निर्भीक डिजिटल पत्रिका" : "Impartial & Fearless News")</small>
                        </div>
                    </div>
                    <p style="font-size: 0.88rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 12px;">
                        @(isNepali ? "सूचना तथा जनसम्पर्क विभाग, सिक्किम दर्ता नं: SK-1234/2026 | प्रेस काउन्सिल अफ इन्डिया दर्ता सूचीकृत" : "Dept. of IPR, Govt. of Sikkim Reg No: SK-1234/2026 | Press Council of India Listed")
                    </p>

                    <!-- Chief Editor Badge -->
                    <div style="display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 10px; width: fit-content;">
                        <img src="~/images/managing-director.jpg" style="width: 44px; height: 50px; object-fit: cover; border-radius: 6px; border: 2px solid var(--primary-red);" alt="Bishnu Neopaney" />
                        <div>
                            <div style="font-size: 0.85rem; font-weight: 800; color: var(--text-primary);">@(isNepali ? "विष्णु न्यौपाने" : "Bishnu Neopaney")</div>
                            <small style="font-size: 0.74rem; color: var(--primary-red); font-weight: 700; display: block;">@(isNepali ? "प्रधान सम्पादक" : "Chief Editor")</small>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 14px;">
                        <a href="https://facebook.com" target="_blank" style="color: white; background: #1877F2; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://twitter.com" target="_blank" style="color: white; background: #000; border: 1px solid #333; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-x-twitter"></i></a>
                        <a href="https://youtube.com" target="_blank" style="color: white; background: #FF0000; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <!-- Policies & Transparency Links -->
                <div>
                    <h4 style="color: var(--text-primary); font-size: 1.05rem; margin-bottom: 14px; border-left: 3px solid var(--primary-red); padding-left: 8px;">
                        @(isNepali ? "नीति तथा आचारसंहिता" : "Policies & Ethics")
                    </h4>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem;">
                        <li><a asp-controller="Home" asp-action="About" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-angle-right" style="color: var(--primary-red); margin-right: 6px;"></i> @(isNepali ? "हाम्रो बारेमा (About Us)" : "About Us")</a></li>
                        <li><a asp-controller="Home" asp-action="EditorialPolicy" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-angle-right" style="color: var(--primary-red); margin-right: 6px;"></i> @(isNepali ? "सम्पादकीय र सच्याउने नीति" : "Editorial & Correction Policy")</a></li>
                        <li><a asp-controller="Home" asp-action="Ethics" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-angle-right" style="color: var(--primary-red); margin-right: 6px;"></i> @(isNepali ? "प्रेस आचारसंहिता (Code of Ethics)" : "Code of Ethics")</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-angle-right" style="color: var(--primary-red); margin-right: 6px;"></i> @(isNepali ? "गोपनीयता नीति (Privacy Policy)" : "Privacy Policy")</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-angle-right" style="color: var(--primary-red); margin-right: 6px;"></i> @(isNepali ? "नियम तथा शर्तहरू (Terms)" : "Terms & Conditions")</a></li>
                    </ul>
                </div>

                <!-- Contact & Media Kit Links -->
                <div>
                    <h4 style="color: var(--text-primary); font-size: 1.05rem; margin-bottom: 14px; border-left: 3px solid var(--brand-blue); padding-left: 8px;">
                        @(isNepali ? "सम्पर्क र विज्ञापन" : "Contact & Media Kit")
                    </h4>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem;">
                        <li><a asp-controller="Home" asp-action="Contact" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-headset" style="color: var(--brand-blue); margin-right: 6px;"></i> @(isNepali ? "सम्पर्क गर्नुहोस् (Contact Us)" : "Contact Us")</a></li>
                        <li><a asp-controller="Home" asp-action="Advertise" style="color: var(--text-secondary); text-decoration: none;"><i class="fas fa-bullhorn" style="color: var(--brand-blue); margin-right: 6px;"></i> @(isNepali ? "विज्ञापन / मिडिया किट (Media Kit)" : "Advertise / Media Kit")</a></li>
                        <li><span style="color: var(--text-muted);"><i class="fas fa-map-marker-alt" style="margin-right: 6px;"></i> @(isNepali ? "डेभलपमेन्ट एरिया, जीवन थिङ मार्ग, ग्याङटोक - ७३७१०१" : "Development Area, Jeewan Theeng Marg, Gangtok - 737101")</span></li>
                        <li><span style="color: var(--text-muted);"><i class="fas fa-phone-alt" style="margin-right: 6px;"></i> @(isNepali ? "+९१-९८८३७०२८०७" : "+91-9883702807")</span></li>
                    </ul>
                </div>

            </div>

            <div style="border-top: 1px solid var(--border-color); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 0.86rem; color: var(--text-muted);">
                <div>
                    © २०८३ अनलाइन् खबर पत्रिका। सर्वअधिकार सुरक्षित। (Google News JSON-LD SEO + ASP.NET Core 8.0)
                </div>
                <div>
                    <a asp-controller="Account" asp-action="Login" style="color: var(--primary-red); text-decoration: none; font-weight: 600;">
                        <i class="fas fa-user-lock"></i> @(isNepali ? "प्रशासन लगइन" : "Admin Portal")
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Interactive Mobile Nav, Theme & Font Size Switcher Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const htmlTag = document.documentElement;

            // 1. Mobile Menu Toggle
            const btn = document.getElementById('mobileNavBtn');
            const nav = document.querySelector('.nav-links');
            if (btn && nav) {
                btn.addEventListener('click', function() {
                    nav.classList.toggle('active');
                    const icon = btn.querySelector('i');
                    if (icon) {
                        icon.className = nav.classList.contains('active') ? 'fas fa-times' : 'fas fa-bars';
                    }
                });
            }

            // 2. Dark / Light Theme Toggle Switcher
            const themeBtn = document.getElementById('themeToggleBtn');
            function syncThemeIcon() {
                if (!themeBtn) return;
                const isDark = htmlTag.getAttribute('data-theme') === 'dark';
                const icon = themeBtn.querySelector('i');
                if (icon) {
                    icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
                }
            }

            syncThemeIcon();

            if (themeBtn) {
                themeBtn.addEventListener('click', function() {
                    const currentTheme = htmlTag.getAttribute('data-theme');
                    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                    htmlTag.setAttribute('data-theme', newTheme);
                    localStorage.setItem('patrikaTheme', newTheme);
                    syncThemeIcon();
                });
            }

            // 3. Font Size Switcher (Small, Medium, Large)
            const fontBtns = document.querySelectorAll('.font-size-btn');
            const currentFontSize = localStorage.getItem('patrikaFontSize') || 'medium';
            htmlTag.setAttribute('data-font-size', currentFontSize);

            fontBtns.forEach(fBtn => {
                const btnSize = fBtn.getAttribute('data-size');
                if (btnSize === currentFontSize) {
                    fBtn.classList.add('active');
                } else {
                    fBtn.classList.remove('active');
                }

                fBtn.addEventListener('click', function() {
                    const targetSize = this.getAttribute('data-size');
                    htmlTag.setAttribute('data-font-size', targetSize);
                    localStorage.setItem('patrikaFontSize', targetSize);

                    fontBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
